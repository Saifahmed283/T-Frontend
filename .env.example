# Optional. Base URL of the TerraMorph API. In dev, leave unset — the Vite
# server proxies same-origin /api to VITE_PROXY_TARGET so the httpOnly session
# cookie works without CORS.
# VITE_API_URL=http://localhost:4000

# Dev proxy target for /api (default: http://localhost:4000).
# VITE_PROXY_TARGET=http://localhost:4000
