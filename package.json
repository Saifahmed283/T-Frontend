{
  "name": "terramorph-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vike dev",
    "build": "node scripts/gen-sitemap.mjs && cross-env NODE_ENV=production vike build",
    "sitemap": "node scripts/gen-sitemap.mjs",
    "og-image": "node scripts/gen-og-image.mjs",
    "preview": "vike preview",
    "format": "oxfmt",
    "a11y": "node scripts/a11y.mjs",
    "security:check": "node scripts/security-check.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit && vitest run"
  },
  "dependencies": {
    "lucide-react": "1.57.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vike": "^0.4.268",
    "vike-react": "^0.6.29"
  },
  "devDependencies": {
    "@axe-core/react": "^4.13.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "axe-core": "^4.14.0",
    "cross-env": "^10.1.0",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.2.0",
    "puppeteer-core": "^25.13.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.1.6",
    "vitest": "^5.0.5"
  }
}
